{
  "disclosures": [
    {
      "identifier": "_pubcid_optout",
      "type": "cookie",
      "maxAgeSeconds": 31536000,
      "cookieRefresh": false,
      "domains": ["*"],
      "purposes": [],
      "optOut": true
    },
    {
      "identifier": "_pubcid_optout",
      "type": "web",
      "domains": ["*"],
      "purposes": [],
      "optOut": true
    },
    {
      "identifier": "_pubcid_optout_exp",
      "type": "web",
      "domains": ["*"],
      "purposes": [],
      "optOut": true
    },
    {
      "identifier": "_gd*_sharedId",
      "type": "cookie",
      "maxAgeSeconds": 0,
      "cookieRefresh": false,
      "domains": ["*"],
      "purposes": [1],
      "description": "Temporary probing cookie, written and immediately deleted, to determine the top-level domain on which cookies can be set"
    }
  ],
  "domains": [
    {
      "domain": "*",
      "use": "SharedId looks for an opt-out flag in both cookies and localStorage; disables itself if it finds one"
    }
  ]
}
