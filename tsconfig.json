// Compiles the sources. The options a consumer's compiler has live in tsconfig-strict.json, which
// this extends; what is here is what the build needs on top of them - emit, and the looseness the
// sources still need.
{
  "extends": "./tsconfig-strict.json",
  "compilerOptions": {
    // Ensure that .d.ts files are created by tsc, but not .js files
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // Ensure that Babel can safely transpile files in the TypeScript project
    "isolatedModules": true,
    "rootDir": "./",
    "outDir": "./dist/src/",
    // the sources are not strict yet; the declarations they emit are checked as a consumer sees them
    // by `gulp ts-strict`
    "strict": false,
    "allowJs": false,
    "checkJs": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*.ts",
  ],
  "exclude": [
    "./dist/**/*",
    "./build/**/*",
    "./node_modules/**/*",
    "integrationExamples/**/*"
  ]
}
