// Type checks the declarations generated by `gulp build`, the way a compiler outside this
// repository sees them: only the published output, and the options below.
//
// These are also the options that describe what a consumer's compiler has, and tsconfig.json extends
// this so that they are stated once. What the build needs on top of them - emit, and the looseness
// the sources still need - lives there, as deviations from what a consumer gets.
{
  "compilerOptions": {
    // honour package.json "exports"; the packages the declarations refer to do not resolve without it
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // the target and libraries Prebid is built for
    "target": "es2019",
    "lib": ["es2019", "DOM"],
    // @types packages are dev dependencies, and not part of the published package
    "types": [],
    "strict": true,
    "noEmit": true
  },
  "include": ["./dist/src/**/*.ts"]
}
