// Type checks the declarations generated by `gulp build`, the way a compiler outside this
// repository sees them: only the published output, and no options other than the ones below.
{
  "compilerOptions": {
    // honour package.json "exports"; the packages the declarations refer to do not resolve without it
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // the target and libraries Prebid is built for
    "target": "es2019",
    "lib": ["es2019", "DOM"],
    // @types packages are dev dependencies, and not part of the published package
    "types": [],
    "strict": true,
    "noEmit": true
  },
  "include": ["./dist/src/**/*.ts"]
}
