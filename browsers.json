{
  "chrome": {
    "name": "Chrome",
    "runner": {
      "runsOn": "ubuntu-latest",
      "wdio": "chrome"
    },
    "browserstack": {
      "browserName": "chrome",
      "browserVersion": "latest",
      "os": "Windows",
      "osVersion": "11"
    }
  },
  "firefox": {
    "name": "Firefox",
    "runner": {
      "runsOn": "ubuntu-latest",
      "wdio": "firefox",
      "vitest": {
        "browser": "firefox",
        "playwright": "firefox",
        "shards": 2
      }
    },
    "browserstack": {
      "browserName": "firefox",
      "browserVersion": "latest",
      "os": "Windows",
      "osVersion": "11"
    }
  },
  "safari": {
    "name": "Safari",
    "runner": {
      "runsOn": "macos-latest",
      "wdio": "safari",
      "vitest": {
        "browser": "safari",
        "safari": true,
        "shards": 2
      }
    },
    "browserstack": {
      "browserName": "safari",
      "browserVersion": "latest",
      "os": "OS X",
      "osVersion": "Tahoe"
    }
  },
  "edge": {
    "name": "Edge",
    "runner": {
      "runsOn": "windows-latest",
      "wdio": "msedge",
      "vitest": {
        "channel": "msedge",
        "shards": 1
      }
    },
    "browserstack": {
      "browserName": "edge",
      "browserVersion": "latest",
      "os": "Windows",
      "osVersion": "11"
    }
  },
  "chrome_113": {
    "name": "Chrome 113",
    "runner": {
      "runsOn": "ubuntu-latest",
      "vitest": {
        "chromeVersion": "113.0.5672.0",
        "shards": 1
      }
    },
    "browserstack": {
      "browserName": "chrome",
      "browserVersion": "113.0",
      "os": "Windows",
      "osVersion": "10"
    }
  },
  "safari_16": {
    "name": "Safari 16",
    "browserstack": {
      "browserName": "safari",
      "browserVersion": "16.5",
      "os": "OS X",
      "osVersion": "Ventura",
      "vitest": {
        "specsMatching": "isSecureContext|\\bsubtle\\b",
        "specsLabel": "secure-context specs"
      }
    }
  },
  "iphone_14": {
    "name": "iPhone 14 iOS 16",
    "browserstack": {
      "browserName": "safari",
      "deviceName": "iPhone 14",
      "osVersion": "16",
      "vitest": {
        "shards": 6,
        "maxParallel": 2
      }
    }
  }
}
